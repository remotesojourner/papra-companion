@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OidcOptions OidcOptions
@inject BrowserInteropService Browser

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<MudLayout data-theme="@ThemeName">
    <MudAppBar Elevation="0" Dense="true" Class="px-3">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="@WebStrings.LayoutToggleNavigation" />
        <a href="" class="pc-brand">
            <img src="logo.svg" alt="" class="pc-brand-logo" />
            <MudText Typo="Typo.h6" Class="font-weight-bold pc-brand-name">@WebStrings.AppName</MudText>
        </a>

        <MudSpacer />

        <div class="d-flex align-center gap-1">
            @if (_userName != null)
            {
                <MudText Typo="Typo.body2" Class="pc-muted pc-user-name">@_userName</MudText>
                <form action="auth/logout" method="post" class="d-flex">
                    <AntiforgeryToken />
                    <MudTooltip Text="@WebStrings.LayoutSignOut">
                        <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Rounded.Logout" Color="Color.Inherit" aria-label="@WebStrings.LayoutSignOut" />
                    </MudTooltip>
                </form>
            }
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleThemeAsync"
                           aria-label="@WebStrings.LayoutToggleTheme" />
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive">
        <MudNavMenu Class="pa-2">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.AutoAwesome">@WebStrings.NavTitleGeneration</MudNavLink>
            <MudNavLink Href="email-attachments" Icon="@Icons.Material.Rounded.Email">@WebStrings.NavEmailAttachments</MudNavLink>
            <MudNavLink Href="settings" Icon="@Icons.Material.Rounded.Settings">@WebStrings.NavSettings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="px-4 px-lg-6 pb-4 pb-lg-6 pt-16">
        <div class="pc-page">
            <ErrorBoundary @ref="_pageErrors">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@WebStrings.LayoutPageErrorTitle</MudText>
                        <MudText Typo="Typo.body2">@WebStrings.LayoutPageErrorDescription</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="mt-3" OnClick="RecoverPage">@WebStrings.TryAgain</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @WebStrings.LayoutUnhandledError
    <a href=".">@WebStrings.LayoutReload</a>
    <span class="dismiss" role="button" aria-label="@WebStrings.LayoutDismiss">✕</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private ErrorBoundary? _pageErrors;
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private bool _themeLoaded;
    private string? _userName;

    private string? ThemeName => _themeLoaded ? (_isDarkMode ? "dark" : "light") : null;

    protected override async Task OnInitializedAsync()
    {
        if (!OidcOptions.Enabled) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userName = authState.User.Identity?.IsAuthenticated == true ? authState.User.Identity.Name : null;
    }

    protected override void OnParametersSet() => _pageErrors?.Recover();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _isDarkMode = await Browser.GetLocalStorageAsync(AppTheme.ThemeStorageKey) switch
        {
            "dark" => true,
            "light" => false,
            _ => _themeProvider != null && await _themeProvider.GetSystemDarkModeAsync()
        };
        _themeLoaded = true;
        StateHasChanged();
    }

    private void RecoverPage() => _pageErrors?.Recover();

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await Browser.SetLocalStorageAsync(AppTheme.ThemeStorageKey, _isDarkMode ? "dark" : "light");
    }
}
