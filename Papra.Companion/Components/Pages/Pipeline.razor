@page "/"
@page "/pipeline"
@inject IPipelineStatusService StatusService
@inject ISettingsService SettingsService
@implements IDisposable

<PageTitle>@WebStrings.Format(WebStrings.PageTitle, WebStrings.PipelineTitle)</PageTitle>

<PageHeader Title="@WebStrings.PipelineHeading" Subtitle="@WebStrings.PipelineSubtitle" />

@if (!SettingsService.Current.IsConfigured)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-6">
        <b>@WebStrings.NotConfigured</b> @WebStrings.PipelineNotConfigured
        <MudLink Href="settings/papra">@WebStrings.PipelineOpenSettings</MudLink>
    </MudAlert>
}

<MudGrid Spacing="4" Class="mb-6">
    <MudItem xs="6" md="3">
        <StatTile Icon="@Icons.Material.Rounded.Autorenew" Title="@WebStrings.PipelineCurrentJob">
            @if (_currentJob is not null)
            {
                <div class="d-flex align-center gap-3">
                    <MudProgressCircular Color="Color.Info" Indeterminate="true" Size="Size.Small" />
                    <div class="d-flex flex-column" style="min-width:0">
                        <MudText Typo="Typo.body1" Color="Color.Info" Class="font-weight-bold">@WebStrings.StatusProcessing</MudText>
                        <MudText Typo="Typo.caption" Class="pc-muted pc-mono-small pc-stat-text" title="@_currentJob.DocumentId">@_currentJob.DocumentId</MudText>
                    </div>
                </div>
            }
            else
            {
                <MudText Typo="Typo.h4" Class="pc-hero-value font-weight-bold pc-muted">@WebStrings.PipelineIdle</MudText>
            }
        </StatTile>
    </MudItem>
    <MudItem xs="6" md="3">
        <StatTile Icon="@Icons.Material.Rounded.Description" Title="@WebStrings.PipelineTotal" Value="@_total.ToString()" Label="@WebStrings.PipelineTotalLabel" />
    </MudItem>
    <MudItem xs="6" md="3">
        <StatTile Icon="@Icons.Material.Rounded.CheckCircle" Title="@WebStrings.StatusSucceeded" Value="@_succeeded.ToString()" Label="@WebStrings.PipelineSucceededLabel" Color="Color.Success" />
    </MudItem>
    <MudItem xs="6" md="3">
        <StatTile Icon="@Icons.Material.Rounded.Error" Title="@WebStrings.StatusFailed" Value="@_failed.ToString()" Label="@WebStrings.PipelineFailedLabel" Color="Color.Error" />
    </MudItem>
</MudGrid>

<StateView Empty="@(_recentJobs.Count == 0)" EmptyMessage="@WebStrings.PipelineEmpty">
    <MudTable Items="_recentJobs" T="PipelineJobResult" Hover="true" Dense="true" Elevation="0" Class="pc-card" Breakpoint="Breakpoint.Sm">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="font-weight-bold">@WebStrings.PipelineRecentActivity</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@WebStrings.PipelineDocumentId</MudTh>
            <MudTh>@WebStrings.PipelineExtractedTitle</MudTh>
            <MudTh>@WebStrings.ColumnStatus</MudTh>
            <MudTh Style="text-align:right">@WebStrings.PipelineDuration</MudTh>
            <MudTh Style="text-align:right">@WebStrings.PipelineTime</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@WebStrings.PipelineDocumentId">
                <span class="pc-mono-small pc-truncate" title="@context.DocumentId">@context.DocumentId</span>
            </MudTd>
            <MudTd DataLabel="@WebStrings.PipelineExtractedTitle">
                <span class="pc-truncate" title="@context.ExtractedTitle">@(context.ExtractedTitle ?? WebStrings.NoValue)</span>
            </MudTd>
            <MudTd DataLabel="@WebStrings.ColumnStatus">
                @switch (context.Status)
                {
                    case JobStatus.Succeeded:
                        <StatusChip Text="@WebStrings.StatusSucceeded" Color="Color.Success" Icon="@Icons.Material.Rounded.CheckCircle" />
                        break;
                    case JobStatus.Failed:
                        <StatusChip Text="@WebStrings.StatusFailed" Color="Color.Error" Icon="@Icons.Material.Rounded.Error" Tooltip="@context.ErrorMessage" />
                        break;
                    case JobStatus.Processing:
                        <StatusChip Text="@WebStrings.StatusProcessing" Color="Color.Info" Icon="@Icons.Material.Rounded.Autorenew" />
                        break;
                    default:
                        <StatusChip Text="@WebStrings.StatusQueued" Color="Color.Info" Icon="@Icons.Material.Rounded.Schedule" />
                        break;
                }
            </MudTd>
            <MudTd DataLabel="@WebStrings.PipelineDuration" Style="text-align:right" Class="pc-nowrap pc-muted">
                @(context.Duration is { } duration ? $"{duration.TotalSeconds:F1}s" : WebStrings.NoValue)
            </MudTd>
            <MudTd DataLabel="@WebStrings.PipelineTime" Style="text-align:right" Class="pc-nowrap pc-muted">
                @context.StartedAt.ToLocalTime().ToString("HH:mm:ss")
            </MudTd>
        </RowTemplate>
    </MudTable>
</StateView>

@code {
    private PipelineJobResult? _currentJob;
    private IReadOnlyList<PipelineJobResult> _recentJobs = [];
    private int _total;
    private int _succeeded;
    private int _failed;

    protected override void OnInitialized()
    {
        StatusService.OnChanged += HandleStatusChanged;
        RefreshStatus();
    }

    private void HandleStatusChanged() => InvokeAsync(() =>
    {
        RefreshStatus();
        StateHasChanged();
    });

    private void RefreshStatus()
    {
        _currentJob = StatusService.CurrentJob;
        _recentJobs = StatusService.RecentJobs;
        _total = _recentJobs.Count;
        _succeeded = _recentJobs.Count(j => j.Status == JobStatus.Succeeded);
        _failed = _recentJobs.Count(j => j.Status == JobStatus.Failed);
    }

    public void Dispose() => StatusService.OnChanged -= HandleStatusChanged;
}
