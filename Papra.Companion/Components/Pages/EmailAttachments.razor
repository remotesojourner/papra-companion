@page "/email-attachments"
@using Papra.Companion.Data.Entities
@inject IEmailAttachmentSettingsService EmailSettingsService
@inject IEmailAttachmentLogRepository LogRepository

<PageTitle>@WebStrings.Format(WebStrings.PageTitle, WebStrings.EmailTitle)</PageTitle>

<PageHeader Title="@WebStrings.EmailHeading" Subtitle="@WebStrings.EmailSubtitle" />

@if (!EmailSettingsService.Current.IsConfigured)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-6">
        <b>@WebStrings.NotConfigured</b> @WebStrings.EmailNotConfigured
        <MudLink Href="settings/email">@WebStrings.EmailOpenSettings</MudLink>
    </MudAlert>
}
else if (!EmailSettingsService.Current.Enabled)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6">
        <b>@WebStrings.EmailDisabledTitle</b> @WebStrings.EmailDisabled
        <MudLink Href="settings/email">@WebStrings.EmailOpenSettings</MudLink>
    </MudAlert>
}

<MudGrid Spacing="4" Class="mb-6">
    <MudItem xs="12" sm="4">
        <StatTile Icon="@Icons.Material.Rounded.AttachFile" Title="@WebStrings.EmailTotal" Value="@_total.ToString()" Label="@WebStrings.EmailTotalLabel" />
    </MudItem>
    <MudItem xs="6" sm="4">
        <StatTile Icon="@Icons.Material.Rounded.CheckCircle" Title="@WebStrings.StatusSucceeded" Value="@_succeeded.ToString()" Label="@WebStrings.EmailSucceededLabel" Color="Color.Success" />
    </MudItem>
    <MudItem xs="6" sm="4">
        <StatTile Icon="@Icons.Material.Rounded.Error" Title="@WebStrings.StatusFailed" Value="@_failed.ToString()" Label="@WebStrings.EmailFailedLabel" Color="Color.Error" />
    </MudItem>
</MudGrid>

<StateView Empty="@(_logs.Count == 0)" EmptyMessage="@WebStrings.EmailEmpty">
    <MudTable Items="_logs" T="EmailAttachmentLogEntity" Hover="true" Dense="true" Elevation="0" Class="pc-card" Breakpoint="Breakpoint.Sm">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="font-weight-bold">@WebStrings.EmailRecentDownloads</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@WebStrings.EmailFilename</MudTh>
            <MudTh>@WebStrings.EmailMessage</MudTh>
            <MudTh>@WebStrings.ColumnStatus</MudTh>
            <MudTh Style="text-align:right">@WebStrings.EmailDownloaded</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@WebStrings.EmailFilename">
                <span class="pc-truncate" title="@context.SavedPath">@context.AttachmentName</span>
            </MudTd>
            <MudTd DataLabel="@WebStrings.EmailMessage">
                <div class="pc-cell-lines">
                    <span title="@context.Subject">@context.Subject</span>
                    <span class="pc-muted mud-typography-caption" title="@context.FromEmail">@context.FromEmail</span>
                </div>
            </MudTd>
            <MudTd DataLabel="@WebStrings.ColumnStatus">
                @if (context.Succeeded)
                {
                    <StatusChip Text="@WebStrings.StatusDownloaded" Color="Color.Success" Icon="@Icons.Material.Rounded.CheckCircle" />
                }
                else
                {
                    <StatusChip Text="@WebStrings.StatusFailed" Color="Color.Error" Icon="@Icons.Material.Rounded.Error" Tooltip="@context.ErrorMessage" />
                }
            </MudTd>
            <MudTd DataLabel="@WebStrings.EmailDownloaded" Style="text-align:right" Class="pc-nowrap pc-muted">
                @context.DownloadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </MudTd>
        </RowTemplate>
    </MudTable>
</StateView>

@code {
    private IReadOnlyList<EmailAttachmentLogEntity> _logs = [];
    private int _total;
    private int _succeeded;
    private int _failed;

    protected override void OnInitialized()
    {
        _logs = LogRepository.GetRecent(100);
        _total = _logs.Count;
        _succeeded = _logs.Count(l => l.Succeeded);
        _failed = _total - _succeeded;
    }
}
