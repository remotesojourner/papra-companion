<MudTextField T="string" Value="@Value" ValueChanged="ValueChanged" Label="@Label"
              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
              InputType="@(_visible ? InputType.Text : InputType.Password)"
              Adornment="Adornment.End" AdornmentIcon="@(_visible ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)"
              AdornmentAriaLabel="@WebStrings.Format(_visible ? WebStrings.SecretHide : WebStrings.SecretShow, Label)" OnAdornmentClick="@(() => _visible = !_visible)"
              Placeholder="@(Saved ? SavedPlaceholder : Placeholder)" HelperText="@HelperText"
              autocomplete="new-password" />

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Saved { get; set; }
    [Parameter] public string SavedPlaceholder { get; set; } = WebStrings.SecretSavedPlaceholder;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }

    private bool _visible;
}
